    @section scripts {



        <script>
            $("#printPDF").click(function () {
                var element = document.getElementById('Ventas');

                html2pdf().from(element).set({
                    jsPDF: {
                        orientation: 'portrait', unit: 'pt', format: 'letter', compressPDF: true
                    }
                }).save()



            });</script>
    }
